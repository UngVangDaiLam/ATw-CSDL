# =============================================================================
#  Sao chép file này thành .env rồi đổi toàn bộ giá trị:
#     cp .env.example .env        (PowerShell: Copy-Item .env.example .env)
#  .env đã nằm trong .gitignore - KHÔNG commit.
# =============================================================================

# --- PostgreSQL: superuser & database ---------------------------------------
POSTGRES_DB=secdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=doi_mat_khau_nay_1

# Cổng trên MÁY HOST. Cố tình không dùng 5432 vì máy dev thường đã cài sẵn
# PostgreSQL native chiếm cổng đó; khi trùng, Docker vẫn bind thành công nhưng
# kết nối lại đi vào instance native chứ không vào container.
POSTGRES_HOST_PORT=15432

# --- Các role nghiệp vụ (02_roles.sh đọc từ đây) ----------------------------
# db_owner      : sở hữu schema app/audit và toàn bộ bảng
# app_user      : backend Express dùng - SELECT/INSERT/UPDATE, không DELETE/DDL
# readonly_user : chỉ đọc customers + orders
# admin_user    : quản trị, KHÔNG phải superuser, làm DDL qua SET ROLE db_owner
# analyzer_user : lớp 3 - CHỈ INSERT vào audit.alerts, không đọc được gì
# dashboard_user: lớp 3 - CHỈ SELECT audit.alerts, không ghi, không chạm app.*
DB_OWNER_PASSWORD=doi_mat_khau_nay_2
APP_USER_PASSWORD=doi_mat_khau_nay_3
READONLY_PASSWORD=doi_mat_khau_nay_4
ADMIN_PASSWORD=doi_mat_khau_nay_5
ANALYZER_PASSWORD=doi_mat_khau_nay_7
DASHBOARD_PASSWORD=doi_mat_khau_nay_8

# --- pgAdmin (http://localhost:8081) ----------------------------------------
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=doi_mat_khau_nay_6

# =============================================================================
#  KHÓA MÃ HÓA (bước 2) - KHÔNG ĐẶT Ở ĐÂY
# =============================================================================
#  Khóa của pgp_sym_encrypt và pepper của HMAC được nạp qua Docker secret
#  (đã khai báo trong docker-compose.yml, mount vào /run/secrets/).
#
#  Sinh chúng bằng:   bash scripts/init-secrets.sh
#
#  Database tự đọc khóa qua ext.master_key(); ứng dụng KHÔNG bao giờ thấy khóa,
#  chỉ gọi app.encrypt_text / app.decrypt_text / app.blind_index.
#
#  Lý do không để trong .env và tuyệt đối không để trong database:
#  nếu khóa nằm cùng chỗ với dữ liệu đã mã hóa thì việc mã hóa không còn ý
#  nghĩa - kẻ lấy được dump database sẽ có luôn khóa để giải mã.
#  .env cũng bị nạp vào biến môi trường của container nên `docker inspect`
#  hoặc /proc/<pid>/environ đều đọc được, trong khi Docker secret nằm ở
#  tmpfs với quyền hạn chế.
