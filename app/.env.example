# Sao chép thành app/.env rồi đổi giá trị. KHÔNG commit .env (đã có trong
# .gitignore gốc: .env / .env.* ở mọi thư mục).
#
# Chạy app trên MÁY HOST (ngoài Docker) -> nối qua cổng publish 15432, KHÔNG
# phải 5432 (xem CLAUDE.md mục "Bẫy 5"). Nếu sau này dockerize app/ và cho nó
# vào chung network `dbnet` thì đổi DB_HOST thành 172.28.0.10 và DB_PORT về 5432.
DB_HOST=localhost
DB_PORT=15432
DB_NAME=secdb
DB_USER=app_user
DB_PASSWORD=doi_mat_khau_nay_3

# express-session - đổi thành chuỗi ngẫu nhiên dài khi deploy thật.
SESSION_SECRET=doi_chuoi_bi_mat_nay

PORT=3000

# LƯU Ý: KHÔNG có ENCRYPTION_KEY ở đây. Khóa mã hóa cccd/card_token nằm trong
# Docker secret, chỉ database đọc được qua ext.master_key(). app/ chỉ gọi
# app.encrypt_text()/app.decrypt_text()/app.blind_index() và không bao giờ
# thấy khóa - xem postgres/init/05_crypto.sql.
