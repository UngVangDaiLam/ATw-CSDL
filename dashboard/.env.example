# Sao chép thành dashboard/.env rồi đổi giá trị. KHÔNG commit .env.
#
# Chạy dashboard trên MÁY HOST -> nối qua cổng publish 15432, KHÔNG phải 5432
# (xem CLAUDE.md "Bẫy 5"). Nếu dockerize và cho vào network `dbnet` thì đổi
# DB_HOST thành 172.28.0.10 và DB_PORT về 5432.
DB_HOST=localhost
DB_PORT=15432
DB_NAME=secdb

# PHẢI là dashboard_user - lấy mật khẩu ở DASHBOARD_PASSWORD trong .env gốc.
# Role này chỉ SELECT được audit.alerts. Đừng đổi sang app_user hay db_owner
# "cho tiện": app_user bị cố ý chặn khỏi schema audit, còn db_owner là chủ sở
# hữu toàn bộ bảng.
DB_USER=dashboard_user
DB_PASSWORD=doi_mat_khau_nay_8

# Chu kỳ hỏi cảnh báo mới (ms). Xem README mục "Realtime" - vì sao poll chứ
# không LISTEN/NOTIFY.
POLL_INTERVAL_MS=2000

PORT=4000
