# Sao chép thành analyzer/.env rồi đổi giá trị. KHÔNG commit .env.
#
# Chạy analyzer trên MÁY HOST -> nối qua cổng publish 55432, KHÔNG phải 5432
# (xem CLAUDE.md "Bẫy 5"). Nếu sau này dockerize analyzer/ và cho vào network
# `dbnet` thì đổi DB_HOST thành 172.28.0.10 và DB_PORT về 5432.
DB_HOST=localhost
DB_PORT=55432
DB_NAME=secdb

# PHẢI là analyzer_user. Role này chỉ có INSERT trên audit.alerts - không đọc,
# không sửa, không xóa, và không chạm được schema `app`.
# Đừng đổi sang app_user "cho tiện": đó là tự tay nới quyền của tiến trình phân
# tích lên bằng quyền của cả ứng dụng.
DB_USER=analyzer_user
DB_PASSWORD=doi_mat_khau_nay_7

# Thư mục log của PostgreSQL (bind-mount ra ./logs). Analyzer đọc bản .json,
# KHÔNG đọc .csv - câu SQL trong CSV có thể chứa ký tự xuống dòng thật nên
# đọc theo từng dòng sẽ rách câu lệnh làm đôi.
LOG_DIR=../logs

# File ghi nhớ đã đọc tới đâu. Cần thiết vì analyzer_user không có quyền SELECT
# nên không thể hỏi ngược database xem cảnh báo nào đã ghi rồi.
STATE_FILE=./.analyzer-state.json

# --- Tham số rule -----------------------------------------------------------
# Giờ hành chính, theo log_timezone của database (Asia/Ho_Chi_Minh).
BUSINESS_HOUR_START=7
BUSINESS_HOUR_END=19
FLAG_WEEKEND=true

# Số bản ghi bị giải mã trong MỘT câu lệnh để bị coi là rút dữ liệu hàng loạt.
BULK_DECRYPT_THRESHOLD=50

# Bảng coi là nhạy cảm (phân tách bằng dấu phẩy).
SENSITIVE_TABLES=app.customers,app.payments
CREDENTIAL_TABLE=app.staff

# Bỏ qua phiên đi qua unix socket (superuser + script init). Đặt false để soi
# cả hoạt động quản trị - lưu ý riêng lần seed đã để lại ~47.000 dòng log.
IGNORE_LOCAL_SOCKET=true
