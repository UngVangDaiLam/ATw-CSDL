{
  "name": "secdb-dashboard",
  "version": "0.2.0",
  "private": true,
  "description": "LOP 3 - chieu doc: hien thi audit.alerts theo thoi gian thuc. Backend Node ket noi bang dashboard_user (CHI SELECT audit.alerts), poll theo id roi day xuong trinh duyet qua Socket.IO; giao dien React.",
  "type": "module",
  "scripts": {
    "dev": "node node_modules/concurrently/dist/bin/concurrently.js -n server,web -c blue,white \"node --watch server/index.js\" \"node node_modules/vite/bin/vite.js\"",
    "dev:server": "node --watch server/index.js",
    "dev:web": "node node_modules/vite/bin/vite.js",
    "build": "node node_modules/vite/bin/vite.js build",
    "start": "node server/index.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "vite": "^5.4.0"
  }
}
